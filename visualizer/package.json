{
  "name": "cyberjam-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CyberJam React visualizer — Menu + Visualizer views consuming the engine WebSocket/Web Audio contracts.",
  "scripts": {
    "dev": "bash ./dev.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "pixi.js": "8.6.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.2"
  },
  "overrides": {
    "vite": "6.4.6",
    "esbuild": "0.25.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.4.6",
    "vitest": "2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
